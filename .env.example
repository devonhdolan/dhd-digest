# Postgres with pgvector (Neon free tier works)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Pick ONE ingestion path.
# A) Feedbin (recommended): handles both RSS and newsletter-to-feed
FEEDBIN_USER=you@example.com
FEEDBIN_PASSWORD=...

# B) Gmail IMAP fallback
IMAP_HOST=imap.gmail.com
IMAP_USER=dhd.digest@gmail.com
IMAP_PASSWORD=            # 16-char app password, requires 2FA
IMAP_FOLDER=Newsletters
